DATA_DIR=.data
PORT=55021
# Required in production; use your exact public HTTPS origin, without trailing slash.
# APP_ORIGIN=https://your-app.fly.dev
# GEMINI_API_KEY=
# OpenAI is used for all text normalization and optional OpenAI speech.
# OPENAI_API_KEY=
# Shared generation is disabled by default. Set the relevant provider keys and positive allowances to enable it.
SERVICE_DAILY_CHARACTERS=0
SERVICE_GLOBAL_DAILY_CHARACTERS=0
MAX_OWNER_BYTES=2147483648
MAX_STORAGE_BYTES=7516192768
MAX_CONCURRENT_JOBS=3
MAX_ACCOUNTS=1000

# Optional static frontend allowed to access the API with a tab-scoped session token.
# PUBLIC_WEB_URL=https://your-user.github.io/adt-speech-studio/
