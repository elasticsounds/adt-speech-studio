{
  "name": "adt-speech-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "node dist/api/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/build-pages.mjs --test && playwright test",
    "fixture": "tsx scripts/fixture.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@tanstack/react-query": "^5.90.0",
    "hono": "^4.13.16",
    "js-yaml": "^4.1.1",
    "linkedom": "^0.18.12",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.27.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
